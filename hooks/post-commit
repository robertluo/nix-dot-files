#!/usr/bin/env bash
# Post-commit hook: regenerate README.md after commits that touch config files.
# Runs in the devenv environment, so scripts are available directly.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Check if any relevant config file is in the last commit
if ! git diff-tree --no-commit-id --name-only -r HEAD | grep -qE '(flake\.nix|home\.nix|devenv\.nix|devenv\.yaml|dotfiles/)'; then
  exit 0
fi

cd "$REPO_ROOT"
echo "[post-commit] Config files changed — regenerating README.md..."

update-readme

echo "[post-commit] README.md regenerated. Amend your commit:"
echo "  git add README.md && git commit --amend --no-edit"